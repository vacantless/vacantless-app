# Copy to .env.local and fill in from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Supabase → Project Settings → API → service_role (KEEP SECRET, never expose to the browser).
# Used only by the RLS verification script (scripts/verify-rls.mjs), never in app runtime.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Dark by default. The compliance-calendar cron only scans orgs when this is true/1
# and the organization has compliance_calendar_enabled=true.
COMPLIANCE_CALENDAR_ENABLED=false

# Dark by default. When set to 1, renter-facing mail goes out FROM the org's own
# <mail_alias>@vacantless.com instead of the shared leads@vacantless.com sender
# (lib/email.ts senderOf). Operator notifications are unaffected. Do NOT set this
# until all three locks are in place, in this order: (1) the ImprovMX alias exists
# and forwards to both the customer inbox and <alias>@in.vacantless.com, (2) the
# organization's mail_alias is set in Settings, (3) Postmark points at
# /api/inbound/reply. Setting it early sends renter mail from an address that
# bounces.
RENTER_FROM_ORG_ALIAS=0
